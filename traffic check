#!/bin/bash

TELEGRAM_BOT_TOKEN="xxxxx"
TELEGRAM_CHAT_ID="-xxxxxx"

INTERFACES=("enp1s0" "enp2s0" "enp3s0" "enp4s0")
THRESHOLD=1
INTERVAL=1

send_telegram_message() {
    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
        --data-urlencode "text=$1" > /dev/null
}

read_counter() {
    cat "/sys/class/net/$1/statistics/$2" 2>/dev/null
}

declare -A rx_before tx_before

for iface in "${INTERFACES[@]}"; do
    rx_before[$iface]=$(read_counter "$iface" rx_bytes)
    tx_before[$iface]=$(read_counter "$iface" tx_bytes)
done

sleep "$INTERVAL"

message=""

for iface in "${INTERFACES[@]}"; do
    [ -z "${rx_before[$iface]}" ] || [ -z "${tx_before[$iface]}" ] && continue

    rx_after=$(read_counter "$iface" rx_bytes)
    tx_after=$(read_counter "$iface" tx_bytes)
    [ -z "$rx_after" ] || [ -z "$tx_after" ] && continue

    rx_rate=$(( (rx_after - rx_before[$iface]) / INTERVAL ))
    tx_rate=$(( (tx_after - tx_before[$iface]) / INTERVAL ))

    if [ "$rx_rate" -gt "$THRESHOLD" ] || [ "$tx_rate" -gt "$THRESHOLD" ]; then
        message+="$iface: RX=${rx_rate} B/s, TX=${tx_rate} B/s"$'\n'
    fi
done

if [ -n "$message" ]; then
    send_telegram_message "Traffic detected:"$'\n'"$message"
fi
